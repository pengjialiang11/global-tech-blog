# ===== 站点 =====
# 真实域名（用于 sitemap / canonical / RSS / OG）
NEXT_PUBLIC_SITE_URL=https://www.sinotechlens.com

# ===== 后台登录（next-auth Credentials）=====
ADMIN_USER=admin
ADMIN_PASS=TechLens2026
NEXTAUTH_SECRET=14365087e4aecda316333ea164216a3dc05efbf58fc9475d121382b456b56640

# ===== 广告（计划书 5.1）=====
# 替换为你的真实 Google AdSense Publisher ID；留空则显示占位
NEXT_PUBLIC_ADSENSE_PUB=ca-pub-XXXXXXXXXXXXXXXX

# ===== 数据分析（计划书 六：GDPR/CCPA 同意门控）=====
# provider: ga4 | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=ga4
# ga4: G-XXXX ; plausible: your-domain.com
NEXT_PUBLIC_ANALYTICS_ID=

# ===== 内容存储（让后台在 Vercel 上也能 增/改/删 + 传图）=====
# 必须：一个 GitHub Fine-grained PAT，Repository permissions -> Contents = Read and write
# 作用：后台写入 articles.json / affiliates.json / 图片时改的是 GitHub 仓库，
#       然后 Vercel 自动重新部署，线上内容才真正更新。
GITHUB_TOKEN=
# 仓库，格式 owner/repo
GITHUB_REPO=pengjialiang11/global-tech-blog
# 分支，默认 main
GITHUB_BRANCH=main

